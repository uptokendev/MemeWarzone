# LIVE Coolify paste for BNB mainnet gen-8 (chain 56).
# Fill every <from mainnet.gen8.json ...> placeholder from
# deployments/bsc/mainnet.gen8.json after the founder deploy.
# Do not set these until that file exists. Leave the existing chain 97 and 46630 lines in place.
# Launches stay paused until the opening-day Safe batch. This paste does not unpause anything.
# The display factory has no env var.
# Create signer stays the production route authority already on LIVE. Do not add a private key here.
# Router is Universal Router 2.1.2 (runtime 24380 bytes), layout v2.1.
# PoolManager and the quoter below are the canonical Uniswap V4 contracts. Do not deploy another V4.

# --- API and indexer ---
EVM_GEN8_LAUNCHER_56=<from mainnet.gen8.json addresses.launcher>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_HOOK_56=<from mainnet.gen8.json addresses.hook>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_LENS_56=<from mainnet.gen8.json addresses.lens>
EVM_GEN8_POOL_MANAGER_56=0x28e2Ea090877bF75740558f6BFB36A5ffeE9e9dF
EVM_GEN8_SPLITTER_56=<from mainnet.gen8.json addresses.splitter>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_CHOICE_VAULT_56=<from mainnet.gen8.json addresses.vault>
EVM_GEN8_RESERVE_LOCK_56=<from mainnet.gen8.json addresses.lock>
EVM_GEN8_ESCROW_56=<from mainnet.gen8.json addresses.escrow>
EVM_GEN8_UNIVERSAL_ROUTER_56=0xDc264714F68d84CF29BC605589405E78bDBE7C9f
EVM_GEN8_UNIVERSAL_ROUTER_LAYOUT_56=v2.1
EVM_GEN8_V4_QUOTER_56=0x9F75dD27D6664c475B90e105573E550ff69437B0

# --- app (Vite, baked at build, no @startBlock) ---
VITE_EVM_GEN8_LAUNCHER_56=<from mainnet.gen8.json addresses.launcher>
VITE_EVM_GEN8_HOOK_56=<from mainnet.gen8.json addresses.hook>
VITE_EVM_GEN8_LENS_56=<from mainnet.gen8.json addresses.lens>
VITE_EVM_GEN8_POOL_MANAGER_56=0x28e2Ea090877bF75740558f6BFB36A5ffeE9e9dF
VITE_EVM_GEN8_UNIVERSAL_ROUTER_56=0xDc264714F68d84CF29BC605589405E78bDBE7C9f
VITE_EVM_GEN8_UNIVERSAL_ROUTER_LAYOUT_56=v2.1
VITE_EVM_GEN8_V4_QUOTER_56=0x9F75dD27D6664c475B90e105573E550ff69437B0
VITE_EVM_GEN8_ESCROW_56=<from mainnet.gen8.json addresses.escrow>
VITE_EVM_GEN8_CHOICE_VAULT_56=<from mainnet.gen8.json addresses.vault>
