# LIVE Coolify paste for Robinhood mainnet gen-8 (chain 4663).
# Fill every <from mainnet.gen8.json ...> placeholder from
# deployments/robinhood/mainnet.gen8.json after the founder deploy.
# Do not set these until that file exists. Leave the existing chain 46630 lines in place.
# Launches stay paused until the opening-day Safe batch. This paste does not unpause anything.
# Robinhood has no display factory. The hook is constructed with address(0) for that argument.
# Create signer stays the production route authority already on LIVE. Do not add a private key here.
# Router is Universal Router 2.1.2 (runtime 24380 bytes), layout v2.1.
# The docs-site router 0x8876789976decbfcbbbe364623c63652db8c0904 is a different runtime. Do not use it.
# PoolManager and the quoter below are the canonical Uniswap V4 contracts. Do not deploy another V4.

# --- API and indexer ---
EVM_GEN8_LAUNCHER_4663=<from mainnet.gen8.json addresses.launcher>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_HOOK_4663=<from mainnet.gen8.json addresses.hook>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_LENS_4663=<from mainnet.gen8.json addresses.lens>
EVM_GEN8_POOL_MANAGER_4663=0x8366a39CC670B4001A1121B8F6A443A643e40951
EVM_GEN8_SPLITTER_4663=<from mainnet.gen8.json addresses.splitter>@<from mainnet.gen8.json factoryStartBlock>
EVM_GEN8_CHOICE_VAULT_4663=<from mainnet.gen8.json addresses.vault>
EVM_GEN8_RESERVE_LOCK_4663=<from mainnet.gen8.json addresses.lock>
EVM_GEN8_ESCROW_4663=<from mainnet.gen8.json addresses.escrow>
EVM_GEN8_UNIVERSAL_ROUTER_4663=0x204FAca1764B154221e35c0d20aBb3c525710498
EVM_GEN8_UNIVERSAL_ROUTER_LAYOUT_4663=v2.1
EVM_GEN8_V4_QUOTER_4663=0x8Dc178eFB8111BB0973Dd9d722ebeFF267c98F94

# --- app (Vite, baked at build, no @startBlock) ---
VITE_EVM_GEN8_LAUNCHER_4663=<from mainnet.gen8.json addresses.launcher>
VITE_EVM_GEN8_HOOK_4663=<from mainnet.gen8.json addresses.hook>
VITE_EVM_GEN8_LENS_4663=<from mainnet.gen8.json addresses.lens>
VITE_EVM_GEN8_POOL_MANAGER_4663=0x8366a39CC670B4001A1121B8F6A443A643e40951
VITE_EVM_GEN8_UNIVERSAL_ROUTER_4663=0x204FAca1764B154221e35c0d20aBb3c525710498
VITE_EVM_GEN8_UNIVERSAL_ROUTER_LAYOUT_4663=v2.1
VITE_EVM_GEN8_V4_QUOTER_4663=0x8Dc178eFB8111BB0973Dd9d722ebeFF267c98F94
VITE_EVM_GEN8_ESCROW_4663=<from mainnet.gen8.json addresses.escrow>
VITE_EVM_GEN8_CHOICE_VAULT_4663=<from mainnet.gen8.json addresses.vault>
VITE_EVM_GEN8_RESERVE_LOCK_4663=<from mainnet.gen8.json addresses.lock>
