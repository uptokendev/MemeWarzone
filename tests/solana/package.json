{
  "name": "memewarzone-solana-local-validator-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "mocha --timeout 1000000 v4-create-acceptance.cjs railway-v4-onchain-decoders.cjs",
    "test:lifecycle": "mocha --timeout 1000000 v4-lifecycle-acceptance.cjs v0-launchpad-onchain.cjs",
    "test:gate-k": "mocha --timeout 1000000 gate-k-meteora.cjs",
    "test:sbf-gate": "mocha --timeout 1000000 v4-create-acceptance.cjs v4-lifecycle-acceptance.cjs v0-launchpad-onchain.cjs gate-k-meteora.cjs",
    "test:railway": "mocha --timeout 120000 railway-v4-conformance.cjs",
    "bootstrap-solana-devnet": "node -r ./web3-loader-compat.cjs devnet-protocol-state.cjs bootstrap",
    "bootstrap-solana-devnet:allow-pause-reset": "node -r ./web3-loader-compat.cjs devnet-protocol-state.cjs bootstrap --allow-pause-reset",
    "verify-solana-devnet": "node devnet-backend-artifact-health.cjs && node verify-solana-devnet.cjs",
    "devnet:bootstrap": "npm run bootstrap-solana-devnet",
    "devnet:verify": "npm run verify-solana-devnet",
    "devnet:preflight": "node devnet-verification-prereqs.cjs",
    "devnet:backend-artifacts": "node devnet-backend-artifact-health.cjs",
    "devnet:deployment-identity": "node -r ./web3-loader-compat.cjs devnet-deployment-identity.cjs",
    "devnet:verify-protocol": "node -r ./web3-loader-compat.cjs devnet-protocol-verify.cjs",
    "devnet:diagnose-generation-manifest": "node -r ./web3-loader-compat.cjs devnet-generation-manifest-diagnose.cjs",
    "devnet:check": "node --check web3-loader-compat.cjs && node --check devnet-verification-prereqs.cjs && node --check devnet-backend-artifact-health.cjs && node --check devnet-deployment-identity.cjs && node --check devnet-protocol-state.cjs && node --check devnet-protocol-verify.cjs && node --check devnet-generation-manifest-diagnose.cjs && node --check verify-solana-devnet.cjs",
    "devnet:trade-ops": "node devnet-trade-ops.cjs",
    "devnet:trade-status": "node devnet-trade-ops.cjs status",
    "devnet:trade-checklist": "node devnet-trade-ops.cjs checklist",
    "print:railway-create-auth": "node print-railway-create-auth-env.cjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@meteora-ag/cp-amm-sdk": "1.4.5",
    "@solana/spl-token": "0.4.8",
    "@solana/web3.js": "1.95.4"
  },
  "devDependencies": {
    "mocha": "10.8.2"
  }
}
