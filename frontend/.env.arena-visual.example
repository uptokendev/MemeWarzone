# Local-only Arena visual QA preset.
# Copy to frontend/.env.local ONLY on a developer workstation, or export these values
# in the shell before `npm run dev:vite`.
#
# This enables the existing browser-local post-grad mock runtime. It does not seed
# Supabase, write chain state, or create production campaigns.

VITE_ENABLE_POSTGRAD=true
VITE_ENABLE_POSTGRAD_ARENA=true
VITE_ENABLE_POSTGRAD_BATTLE=true
VITE_ENABLE_POSTGRAD_EVENTS=true
VITE_ENABLE_POSTGRAD_TOURNAMENT=true
VITE_ENABLE_POSTGRAD_LEAGUE=true
VITE_ENABLE_POSTGRAD_MOCKS=true

# Keep public chain selection deterministic for the visual pass.
VITE_DEFAULT_CHAIN_ID=56
