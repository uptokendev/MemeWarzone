# MemeWarzone Frontend Environment (Vite)

# Chain configuration
# Reads follow the wallet chain automatically (if allowed); otherwise we fall back to default.
VITE_ALLOWED_CHAIN_IDS=56,101
VITE_DEFAULT_CHAIN_ID=56

# Local QA feed split:
# - Campaign-style feeds use BNB testnet so locally deployed factory test tokens are visible.
# - Draft discovery uses BNB mainnet so public Prepare Mode drafts match the dev live site.
# - Create/deploy actions still follow the connected wallet/default chain rules above.
VITE_CAMPAIGN_FEED_CHAIN_ID=56
VITE_FEATURED_FEED_CHAIN_ID=56
VITE_TICKER_FEED_CHAIN_ID=56
VITE_WAR_ROOM_CHAIN_ID=56
VITE_DRAFT_FEED_CHAIN_ID=56

# Chart snapshots are read-only and can query chains independently from wallet safety.
# Use 56 for mainnet-only chart data, or 56,97 for devpostgrad/testnet chart capture.
VITE_TOKEN_CHART_CHAIN_IDS=56,101

# Public RPCs used for read-only calls (logs, balances, etc)
VITE_PUBLIC_RPC_97=https://data-seed-prebsc-1-s1.binance.org:8545/
VITE_PUBLIC_RPC_56=https://bsc-dataseed.binance.org/

# Solana mainnet-beta. Use a paid endpoint for production API/indexer workloads.
VITE_SOLANA_CLUSTER=solana-mainnet-beta
VITE_SOLANA_REWARD_CHAIN_ID=101
VITE_ENABLE_SOLANA_DEVNET_REWARDS=false
VITE_SOLANA_MAINNET_RPC=
VITE_PUBLIC_RPC_101=
VITE_SOLANA_LAUNCHPAD_PROGRAM_ID=
VITE_SOLANA_REWARDS_TREASURY_PROGRAM_ID=
# Static Mainnet Address Lookup Table for user CREATE/BUY/SELL V0 transactions.
# Vite bakes this at frontend build time — set it in Coolify, then rebuild.
# Distinct from operator SOLANA_GRADUATION_ALT_ADDRESS (graduation may extend that table).
# CREATE/BUY/SELL fail closed until this is set. Do not freeze the table until the address list is final.
VITE_SOLANA_LAUNCHPAD_ALT_ADDRESS=AoX2EzL4i2Zb62LjsGU9xWKXbjG9CU5DGH58vxFEYJev
VITE_SOLANA_VOTE_TREASURY_ADDRESS=

# -----------------------------
# BNB launchpad contract wiring
# -----------------------------

# These values are generated from the accepted deployment manifest by running this from the repo root:
# npm run frontend:env:bsc-testnet
# Then copy deployments/bscTestnet.frontend.env into frontend/.env.local or your hosting provider.
# Keep active creation values blank until the corrected generation-3 factory and its locker pass activation verification.
VITE_FACTORY_ADDRESS_97=
VITE_SCHEDULED_FACTORY_ADDRESS_97=
VITE_CAMPAIGN_IMPLEMENTATION_ADDRESS_97=
VITE_TREASURY_ROUTER_ADDRESS_97=
VITE_TREASURY_VAULT_ADDRESS_97=
VITE_RECRUITER_REWARDS_VAULT_ADDRESS_97=
VITE_COMMUNITY_REWARDS_VAULT_ADDRESS_97=
VITE_PROTOCOL_REVENUE_VAULT_ADDRESS_97=
VITE_CREATOR_REGISTRY_ADDRESS_97=
VITE_RISK_REGISTRY_ADDRESS_97=
VITE_GRADUATION_ORACLE_ADDRESS_97=
VITE_PERMANENT_LP_LOCKER_ADDRESS_97=
VITE_VOTE_TREASURY_ADDRESS_97=

# Read/support inventory. These factories remain readable and indexable, but must not receive new creation authorizations.
# Previous supported factory:
# 0xF7872169265eCE4E4C93ef894F1635E84DC6F681
# Obsolete scheduled-slot factory:
# 0xe0FbBa4533513110Cec7e78aa3e48EC45301B5E6
VITE_SUPPORTED_FACTORY_ADDRESSES_97=0xF7872169265eCE4E4C93ef894F1635E84DC6F681,0xe0FbBa4533513110Cec7e78aa3e48EC45301B5E6
VITE_SUPPORTED_FACTORY_START_BLOCKS_97=

# Topaz DEX infrastructure used after campaign graduation.
VITE_TOPAZ_ROUTER_ADDRESS_97=
VITE_TOPAZ_FACTORY_ADDRESS_97=
VITE_TOPAZ_WBNB_ADDRESS_97=

# Mainnet creation factory is the 30 bps / 80-20 locker generation.
# Keep 0x3068… in the supported list for existing campaigns (StandbyFolks).
VITE_FACTORY_ADDRESS_56=0xc378221E57898106079aE4B818a92978e4cd9559
VITE_SUPPORTED_FACTORY_ADDRESSES_56=0xc378221E57898106079aE4B818a92978e4cd9559,0x3068eAE6F8431bFc3c5Faae9c3bBB95F007be59a
VITE_SUPPORTED_FACTORY_START_BLOCKS_56=117413737
VITE_PERMANENT_LP_LOCKER_ADDRESS_56=0xFcE77642e22ef04B8398fB6dfEE99614CAb32f69
VITE_CAMPAIGN_IMPLEMENTATION_ADDRESS_56=
VITE_TREASURY_ROUTER_ADDRESS_56=
VITE_TREASURY_VAULT_ADDRESS_56=
VITE_RECRUITER_REWARDS_VAULT_ADDRESS_56=
VITE_COMMUNITY_REWARDS_VAULT_ADDRESS_56=
VITE_PROTOCOL_REVENUE_VAULT_ADDRESS_56=
VITE_CREATOR_REGISTRY_ADDRESS_56=
VITE_RISK_REGISTRY_ADDRESS_56=
VITE_GRADUATION_ORACLE_ADDRESS_56=
VITE_VOTE_TREASURY_ADDRESS_56=
VITE_TOPAZ_ROUTER_ADDRESS_56=
VITE_TOPAZ_FACTORY_ADDRESS_56=
VITE_TOPAZ_WBNB_ADDRESS_56=

# Optional realtime-indexer base for recruiter / reward program / activity data.
# Local frontend dev falls back to http://localhost:3000 automatically.
# VITE_REALTIME_API_BASE=https://memebattles-production.up.railway.app

# -----------------------------
# Independent devpostgrad API / Railway
# -----------------------------

# Railway should deploy uptokendev/MemeBattles from branch devpostgrad with root/working directory frontend.
# Start command: npm run api:start
# Health endpoints: /, /healthz, /health
#
# IMPORTANT — drafts are NOT stored on git branches.
# campaign_drafts (+ promotion / engagement tables) live only in Supabase/Postgres.
#
# To see live-site Prepare Mode drafts on a devpostgrad deploy (including drafts
# created in the coming days on the live `dev` site):
#   1. Keep SEPARATE Railway *API services* for live `dev` and `devpostgrad`
#      (do not proxy postgrad traffic into the live API process).
#   2. Point BOTH services at the SAME DATABASE_URL (and same Supabase storage
#      project/bucket for logos). New drafts written by live then appear on
#      postgrad automatically — no export/import loop.
#   3. Apply additive postgrad migrations on that shared DB before cutting traffic
#      (scheduled_launch_at, draft_owner_sessions, ticker_reservations, etc.).
#   4. Only use a separate DATABASE_URL for disposable experiments. If you do,
#      live drafts will never show on postgrad until you repoint or dump/restore.
#
# Do not point devpostgrad back at the live dev Railway API; keep the live dev
# service untouched for Prepare Mode. Sharing the database is the correct path.
DATABASE_URL=
# BSC RPC (CSV allowed). Free public endpoints often return 503; the API will
# fail over across the list. Prefer a logs-capable JSON-RPC first (GetBlock,
# Ankr, NodeReal, QuickNode). Public Binance seeds are fallbacks only.
#
# Testnet (chain 97) example — GetBlock free tier (~50k CU/day, ~20 RPS) + Ankr + seed:
# BSC_RPC_HTTP_97=https://go.getblock.io/<ACCESS_TOKEN>,https://rpc.ankr.com/bsc_testnet_chapel/<KEY>,https://data-seed-prebsc-1-s1.binance.org:8545
#
# Identity rule: public /token/:id URLs use the ERC-20 token address; market APIs
# resolve token→campaign automatically (see /api/market/resolve).
BSC_RPC_HTTP_97=
BSC_RPC_HTTP_56=
FACTORY_ADDRESS_56=0xc378221E57898106079aE4B818a92978e4cd9559
SUPPORTED_FACTORY_ADDRESSES_56=0xc378221E57898106079aE4B818a92978e4cd9559,0x3068eAE6F8431bFc3c5Faae9c3bBB95F007be59a
SUPPORTED_FACTORY_START_BLOCKS_56=117413737

# Server-side Solana mainnet-beta configuration.
SOLANA_RPC_HTTP=
SOLANA_RPC_URL_101=
SOLANA_REWARDS_RPC_URL_101=
SOLANA_LAUNCHPAD_PROGRAM_ID=
SOLANA_REWARDS_TREASURY_PROGRAM_ID=
SOLANA_START_SLOT=
FACTORY_ADDRESS_97=
SCHEDULED_FACTORY_ADDRESS_97=
SUPPORTED_FACTORY_ADDRESSES_97=0xF7872169265eCE4E4C93ef894F1635E84DC6F681,0xe0FbBa4533513110Cec7e78aa3e48EC45301B5E6
SUPPORTED_FACTORY_START_BLOCKS_97=
PORT=3001
API_JSON_LIMIT=10mb
API_FORM_LIMIT=10mb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-devpostgrad-frontend.example
VITE_API_BASE_URL=https://your-devpostgrad-api.up.railway.app

# Explicit diagnostic fallback only. Keep false for independent API mode.
# Only enable API_RAILWAY_PROXY for explicit, logged diagnostics while comparing staging to live dev.
API_RAILWAY_PROXY=false
API_RAILWAY_PROXY_STRICT=false
# RAILWAY_API_BASE_URL=
# RAILWAY_FRONTEND_API_BASE_URL=
# RAILWAY_TOKEN_API_BASE_URL=

# -----------------------------
# Post-grad feature flags
# -----------------------------

# Trade War Room ships with the launchpad and is independent from post-grad.
VITE_ENABLE_WAR_ROOM=true

# Master gate for the later post-grad Arena/battle experience.
# VITE_ENABLE_POSTGRAD_ARENA drives hub, battles, tournaments, and Major War League.
# Per-surface flags below default ON once Arena is enabled; keep them false in production examples.
VITE_ENABLE_POSTGRAD=false
VITE_ENABLE_POSTGRAD_ARENA=false
VITE_ENABLE_POSTGRAD_BATTLE=false
VITE_ENABLE_POSTGRAD_EVENTS=false
VITE_ENABLE_POSTGRAD_LEAGUE=false
VITE_ENABLE_POSTGRAD_TOURNAMENT=false

# Creation remains disabled in the example until a corrected factory manifest is applied.
# Wallet, network, route authorization, preflight, and contract checks still apply after enabling.
# BNB Create → Direct deploy (wallet + gas). Requires full factory/Topaz env on that chain.
VITE_ENABLE_DIRECT_BNB_DEPLOY=false
# $6 test graduation tier on BNB testnet (97) and Solana (101). Code defaults ON when unset.
# VITE_ENABLE_TEST_GRADUATION_THRESHOLD=true
VITE_ENABLE_TEST_GRADUATION_THRESHOLD=false
# Draft → Push Live (Solana V4 create and BNB draft deploy finalize).
# VITE_DRAFT_PUSH_LIVE_ENABLED=true
# VITE_ENABLE_DRAFT_PUSH_LIVE=true
VITE_LAUNCHPAD_WRITES_ENABLED=false

# Frontend-only mock roster for testing battle, arena, war room, and event flows.
# Mock data is always explicit opt-in so production/staged builds do not expose fake battle, payout, or settlement data.
VITE_ENABLE_POSTGRAD_MOCKS=false

# Durable Topaz market history from the indexer (candles/trades/state).
# Chart always uses UnifiedMarketChart (TradingView Lightweight) + browser Topaz scans;
# these flags only add server-side dex_trades / candles. Also auto-on when VITE_ENABLE_POSTGRAD=true.
# VITE_ENABLE_UNIFIED_MARKET_CHART=1
# VITE_ENABLE_TOPAZ_MARKET_API=1

# For explicit local sandbox testing, copy these into frontend/.env.local:
# VITE_ENABLE_WAR_ROOM=true
# VITE_ENABLE_POSTGRAD=true
# VITE_ENABLE_POSTGRAD_ARENA=true
# VITE_ENABLE_POSTGRAD_BATTLE=true
# VITE_ENABLE_POSTGRAD_EVENTS=true
# VITE_ENABLE_POSTGRAD_LEAGUE=true
# VITE_ENABLE_POSTGRAD_TOURNAMENT=true
# VITE_ENABLE_DIRECT_BNB_DEPLOY=true
# VITE_ENABLE_POSTGRAD_MOCKS=true
# VITE_ENABLE_UNIFIED_MARKET_CHART=1
# VITE_ENABLE_TOPAZ_MARKET_API=1

# -----------------------------
# Server-only post-grad readiness flags
# -----------------------------

# Trade War Room's read API ships with the launchpad.
WAR_ROOM_ENABLED=true

# These gate additive post-grad backend routes. Keep production values false until matching DB imports,
# contract addresses/ABIs, and QA gates are verified.
POSTGRAD_ARENA_OPS_ENABLED=false
POSTGRAD_BATTLES_ENABLED=false
POSTGRAD_EVENTS_ENABLED=false
POSTGRAD_LEAGUE_ENABLED=false
POSTGRAD_WAR_POOLS_ENABLED=false
POSTGRAD_SPONSORSHIPS_ENABLED=false
POSTGRAD_ARENA_VOTES_ENABLED=false
POSTGRAD_ARENA_IMPORTS_ENABLED=false
# POSTGRAD_ARENA_IMPORTS_ENABLED=true

# For local API sandbox testing, copy these into frontend/.env.local only after importing the matching database SQL files:
# POSTGRAD_ARENA_OPS_ENABLED=true
# POSTGRAD_BATTLES_ENABLED=true
# POSTGRAD_EVENTS_ENABLED=true
# POSTGRAD_LEAGUE_ENABLED=true
# POSTGRAD_WAR_POOLS_ENABLED=true
# POSTGRAD_SPONSORSHIPS_ENABLED=true

