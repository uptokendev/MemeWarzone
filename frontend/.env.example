# -----------------------------
# League auto-payout (Option A)
# -----------------------------

# RPC used by serverless functions + realtime-indexer (CSV failover).
# Prefer GetBlock / Ankr / NodeReal first for eth_getLogs. Public BNB seeds last.
# Example testnet: GetBlock free (~50k CU/day) then Ankr then public seed.
# BSC_RPC_HTTP_97=https://go.getblock.io/<ACCESS_TOKEN>,https://rpc.ankr.com/bsc_testnet_chapel/<KEY>,https://data-seed-prebsc-1-s1.binance.org:8545
BSC_RPC_HTTP_97=https://bsc-testnet-dataseed.bnbchain.org,https://bsc-testnet.bnbchain.org,https://bsc-prebsc-dataseed.bnbchain.org
BSC_RPC_HTTP_56=https://your-paid-or-indexed-bsc-mainnet-rpc.example
INDEXER_NORMAL_SCOPE=core
INDEXER_INTERVAL_MS=30000
INDEXER_LOG_CALL_DELAY_MS=500
LOG_CHUNK_SIZE=250
MIN_LOG_CHUNK_SIZE=50
REPAIR_LOOKBACK_BLOCKS=5000
REPAIR_REWIND_BLOCKS=200
# Graduation handoff: NEVER use FACTORY_LOOKBACK (250k) for CampaignFinalized scans.
# Recent tip windows only; created_block=0 uses UNKNOWN lookback (default 12k).
GRADUATION_HANDOFF_INTERVAL_MS=60000
GRADUATION_HANDOFF_MAX_CAMPAIGNS=25
GRADUATION_LOG_LOOKBACK_BLOCKS=20000
GRADUATION_UNKNOWN_CREATED_LOOKBACK_BLOCKS=12000
GRADUATION_SCAN_COOLDOWN_MS=300000

# TreasuryVaultV2 addresses (chain-specific)
TREASURY_VAULT_V2_ADDRESS_97=
TREASURY_VAULT_V2_ADDRESS_56=

# Operator hot-wallet private key (server-only)
LEAGUE_PAYOUT_OPERATOR_PK=

# Merkle root poster (for user-paid claims)
LEAGUE_ROOT_POSTER_PK=

# -----------------------------
# /live livestream page (Mux + Ably-backed launch event)
# -----------------------------

# Public Mux Playback ID (from Mux dashboard -> Video -> Live Streams -> your stream)
VITE_MUX_PLAYBACK_ID=

# Optional chat channel override; defaults to "live:launch-party" in code.
# VITE_LIVE_CHAT_CHANNEL=live:launch-party

# Feature flag; set to "false" to retire the /live route post-launch without removing code.
# VITE_LIVE_PAGE_ENABLED=true

# Comma-separated wallet addresses that render with a moderator shield in chat.
# Case-insensitive match. Same list maintained in mw-dashboard.
# VITE_LIVE_CHAT_MODERATORS=0xabc...,0xdef...

# --- API auth enforcement (security remediation / go-live) ---
# Production/Railway: unset defaults to ON. Explicit 0 disables one class for rollback.
# Local dev: leave unset (NODE_ENV!=production) → off, or set to 1 to test.
API_AUTH_ENFORCE_INTERNAL=1
API_AUTH_ENFORCE_SECURITY_MUTATIONS=1
API_AUTH_ENFORCE_USER_WRITES=1
API_AUTH_ENFORCE_ARENA_MUTATIONS=1
# RANK_EVENTS_TOKEN=  # required for /api/internal/* when enforce on (also INTERNAL_API_TOKEN alias)
# DASHBOARD_OPS_KEY=  # optional ops automation key for security + harvest
# DASHBOARD_ADMIN_EMAILS=
# DASHBOARD_ADMIN_USER_IDS=

# Abuse notification emails (Resend). Unset = log and skip, API still succeeds.
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=MemeWarzone <noreply@memewar.zone>
# PUBLIC_APP_ORIGIN=https://memewar.zone

# Ably live soft hardening
# ABLY_LIVE_TOKEN_MAX_PER_MIN=30
# ABLY_LIVE_SUBSCRIBE_ONLY=0
