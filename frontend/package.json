    "test:draft-auth": "node --test api/dev-fix/draft-auth.test.mjs",
    "test:campaigns-upsert": "node --import ./api/campaigns/upsert.test.register.mjs --test api/campaigns/upsert.test.mjs",
    "test:abuse-rbac": "node --test api/lib/abuseAuth.test.mjs api/admin/abuse/abuse-rbac.test.mjs api/admin/abuse/abuse-cases.test.mjs api/lib/abuseEvidence.test.mjs api/abuse/abuse-reporter.test.mjs api/lib/abuseNotify.test.mjs api/lib/notify.test.mjs",
    "fix:draft-owner-auth": "node scripts/apply-draft-owner-auth-fix.mjs",
    "worker:contract-sync": "node --import ./api/load-local-env.mjs scripts/run-contract-sync-worker.mjs",
    "worker:creator-funding": "node --import ./api/load-local-env.mjs scripts/run-creator-funding-worker.mjs",
    "worker:creator-funding-indexer": "node --import ./api/load-local-env.mjs scripts/run-creator-funding-indexer.mjs",
    "check:weekly-airdrop": "node --check scripts/weekly-airdrop/config.mjs && node --check scripts/weekly-airdrop/candidates.mjs && node --check scripts/weekly-airdrop/materialize.mjs && node --check scripts/weekly-airdrop/chain.mjs && node --check scripts/weekly-airdrop/run-weekly-airdrop.mjs",
    "airdrop:weekly": "node --import ./api/load-local-env.mjs scripts/weekly-airdrop/run-weekly-airdrop.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test:wallet-discovery": "node --test src/lib/injectedProviderDiscovery.test.mjs",
    "test:feed-isolation": "node --test src/lib/feedChainIsolation.test.mjs",
    "test:e2e:isolation": "playwright test -c playwright.config.ts",
    "test:solana-v0": "node --test src/lib/solanaV0Transaction.test.mjs",
    "test:solana-arena": "node --test src/lib/solanaArenaLayout.test.mjs src/lib/solanaArenaV0.test.mjs",
    "test:arena-mwl": "node --test api/lib/arenaLeagueScoreMath.test.mjs api/lib/arenaBattleSettle.test.mjs api/lib/arenaBattleLive.test.mjs api/lib/arena4aCertification.test.mjs api/lib/arena4dCertification.test.mjs api/lib/arenaLeagueIntegrationV2Certification.test.mjs",
    "test:arena-battle-v2": "node --test api/lib/arenaBattleMetrics.test.mjs api/lib/arenaBattleVolume.test.mjs api/lib/arenaBattlePoints.test.mjs api/lib/arenaBattleV2Certification.test.mjs",
    "test:arena-tournament": "node --test api/lib/arenaTournamentRoster.test.mjs api/lib/arenaTournamentBracketReconcile.test.mjs api/lib/arenaTournamentV2Certification.test.mjs api/lib/arenaSqlIdentity.test.mjs",
    "test:arena-runtime-acceptance": "node --test api/lib/arenaRuntimeAcceptance.test.mjs",
    "test:solana-confirm": "node --test src/lib/solanaConfirmSignature.test.mjs",
    "check:solana-launchpad-alt": "node scripts/solana-launchpad-alt-plan.mjs --json",
    "check:solana-launchpad-alt:live": "node scripts/verify-live-launchpad-alt.mjs",
    "create:solana-launchpad-alt": "node scripts/create-launchpad-alt.mjs",
    "preview": "vite preview",
    "check:core-api": "node scripts/check-core-api-routes.mjs",
    "check:phase3-core-flow": "node scripts/check-phase3-core-flow.mjs",
    "check:contracts": "node scripts/check-contract-readiness.mjs",
    "check:bnb-contract-env": "node scripts/check-bnb-contract-env.mjs",
    "check:launchpad-drill": "node scripts/check-launchpad-drill.mjs"
  },
