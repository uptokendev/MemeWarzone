{
  "name": "memewarzone-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "start": "node scripts/run-railway-api-start.mjs",
    "dev": "node scripts/run-devpostgrad-closeout-fixes.mjs && node scripts/dev-hybrid.mjs",
