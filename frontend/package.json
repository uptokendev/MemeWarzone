    "dev:railway": "node scripts/dev-railway.mjs",
    "dev:vite": "node scripts/dev-vite.mjs",
    "dev:vite:raw": "vite",
    "dev:netlify": "npx netlify dev --context production",
    "api:start": "node scripts/run-railway-api-start.mjs",
    "api:dev": "node scripts/run-devpostgrad-closeout-fixes.mjs && node --watch --import ./api/load-local-env.mjs api/server.mjs",
    "check:home-data": "node scripts/check-home-data.mjs",
    "check:api-migration": "node scripts/check-api-migration-readiness.mjs",
    "check:api-imports": "node scripts/check-api-relative-imports.mjs",
    "check:postgrad-api-preservation": "node scripts/check-postgrad-api-preservation.mjs",
    "check:postgrad-independent-api": "node scripts/check-postgrad-independent-api.mjs",
    "check:postgrad-routing": "node scripts/check-postgrad-routing-readiness.mjs",
    "check:postgrad-economics": "node scripts/check-postgrad-economics-readiness.mjs",
