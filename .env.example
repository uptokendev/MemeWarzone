# Local Hardhat rehearsal
# Use the first Hardhat account for local admin/signer convenience only.
# Never reuse these local defaults for bscTestnet or production.
TREASURY_SAFE=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ROUTE_AUTHORITY_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Route profile IDs: 0=StandardLinked, 1=StandardUnlinked, 2=OgLinked
PHASE1_TRADE_ROUTE_PROFILE=1
PHASE1_FINALIZE_ROUTE_PROFILE=1

# Optional local mocks. If router/price feed are unset on hardhat, deploy scripts use mocks automatically.
# Mocks are rejected by deploy:check-env:bsc-testnet.
# DEPLOY_MOCK_TOPAZ_ROUTER=true
# DEPLOY_MOCK_PRICE_FEED=true
# MOCK_NATIVE_USD_PRICE=600

# BSC testnet deployment
# Use real testnet-controlled accounts and funded keys here, not Hardhat defaults.
# Preferred build-plan names:
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# PRIVATE_KEY_DEPLOY=0x...
# Backward-compatible aliases still accepted:
# BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# DEPLOYER_PK=0x...
# TREASURY_SAFE=0x...
# ROUTE_AUTHORITY_ADDRESS=0x...
# ROUTE_AUTHORITY_PRIVATE_KEY=0x... # optional local verifier signing check only; do not commit real keys

# BSC mainnet deployment (chain 56). Production validation rejects testnet RPCs,
# local accounts, mocks, non-V2 treasury routing, and unsigned external inputs.
# BSC_MAINNET_RPC_URL=https://<paid-chain-56-rpc>
# BSC_MAINNET_RPC=https://<paid-chain-56-rpc>
# PRIVATE_KEY_DEPLOY=0x...
# DEPLOYER_PK=0x...
# TOPAZ_MANIFEST=deployments/bscMainnet/minimal-topaz.json
# DEPLOY_TREASURY_ROUTER_V2=true
# TREASURY_SAFE=0x...
# ROUTE_AUTHORITY_ADDRESS=0x...
# GRADUATION_ORACLE_ADDRESS=0x...
# BNB_USD_PRICE_FEED=0x...
# ETHERSCAN_API_KEY=...

# Topaz / router config. Prefer the manifest exported by MemeWarzone-Topaz.
# TOPAZ_MANIFEST=deployments/bscTestnet/minimal-topaz.json
# TOPAZ_ROUTER=0x...

# Graduation oracle config. Prefer an existing oracle address, or set a real native/USD price feed.
# GRADUATION_ORACLE_ADDRESS=0x...
# BNB_USD_PRICE_FEED=0x...
# GRADUATION_ORACLE_MAX_PRICE_AGE_SECONDS=3600
# Optional and only applied before the factory's first campaign.
# Use a deliberately small value such as 5 for a disposable graduation rehearsal.
# GRADUATION_TARGET_USD=5

# Canonical server candle materialization.
# Enabled by default in the service; set to 0 for an immediate rollback to legacy/fallback candles.
# Derives true curve-state price + market-cap OHLC from durable BNB/Solana trades.
# ENABLE_CANONICAL_CANDLE_MATERIALIZER=1
# CANONICAL_CANDLE_MATERIALIZER_POLL_MS=2000
# CANONICAL_CANDLE_MATERIALIZER_BATCH_SIZE=8

# Pump-style canonical candle realtime rollout.
# Keep disabled until the BNB + Solana candle acceptance matrix passes.
# REST candle snapshots remain authoritative and the existing fallback remains available while disabled.
ENABLE_CANONICAL_CANDLE_REALTIME=0
# CANONICAL_CANDLE_REALTIME_POLL_MS=250
# CANONICAL_CANDLE_REALTIME_BATCH_SIZE=500

# Optional league payout/claim roles and caps. Lanes remain paused unless enabled.
# LEAGUE_PAYOUT_OPERATOR=0x...
# LEAGUE_ROOT_POSTER=0x...
# LEAGUE_PAYOUT_MAX_PER_TX=0
# LEAGUE_PAYOUT_DAILY_CAP=0
# LEAGUE_CLAIM_MAX_PER_TX=0
# LEAGUE_CLAIM_MAX_EPOCH_TOTAL=0
# ENABLE_LEAGUE_PAYOUTS=false
# ENABLE_LEAGUE_CLAIMS=false

# Optional recruiter payout lane. Remains paused unless enabled.
# RECRUITER_PAYOUT_OPERATOR=0x...
# RECRUITER_PAYOUT_MAX_PER_TX=0
# RECRUITER_PAYOUT_DAILY_CAP=0
# ENABLE_RECRUITER_PAYOUTS=false

# Source verification through Etherscan API V2 (required for mainnet)
# ETHERSCAN_API_KEY=...

# Frontend multichain wallet configuration.
# WalletConnect is only advertised when a real public project ID is configured.
# Keep this ID in deployment environment configuration; it is not a wallet secret/private key.
# VITE_WALLETCONNECT_PROJECT_ID=<walletconnect-cloud-project-id>
# Shared EIP-1193 connector RPC overrides by chain ID:
# VITE_PUBLIC_RPC_56=https://<bnb-mainnet-rpc>
# VITE_PUBLIC_RPC_97=https://<bnb-testnet-rpc>
# VITE_PUBLIC_RPC_4663=https://<robinhood-mainnet-rpc>
# VITE_PUBLIC_RPC_46630=https://<robinhood-testnet-rpc>
