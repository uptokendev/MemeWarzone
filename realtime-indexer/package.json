{
  "name": "realtime-indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/tokenSidePreload.ts --import ./src/wtrPreload.ts src/main.ts",
    "start": "node --enable-source-maps --import ./dist/tokenSidePreload.js --import ./dist/wtrPreload.js dist/main.js",
    "build": "tsc -p tsconfig.json",
    "cron:daily-repair": "node --enable-source-maps dist/jobs/dailyRepair.js",
    "cron:sweep-expired-claims": "node --enable-source-maps dist/jobs/sweepExpiredClaims.js",
    "cron:finalize-epoch-winners": "node --enable-source-maps dist/jobs/finalizeEpochWinners.js",
    "cron:export-league-payout-batch": "node --enable-source-maps dist/jobs/exportLeaguePayoutBatch.js",
    "cron:export-recruiter-settlement-batch": "node --enable-source-maps dist/jobs/exportRecruiterSettlementBatch.js",
    "cron:reconcile-attribution": "node --enable-source-maps dist/jobs/reconcileAttribution.js",
    "cron:process-reward-epoch": "node --enable-source-maps dist/jobs/processRewardEpoch.js",
    "cron:process-reward-expiries": "node --enable-source-maps dist/jobs/processRewardExpiries.js",
    "cron:process-reward-eligibility": "node --enable-source-maps dist/jobs/processRewardEligibility.js",
    "cron:process-reward-reminders": "node --enable-source-maps dist/jobs/processRewardReminders.js",
    "simulate:phase7": "node --enable-source-maps dist/jobs/runPhase7Simulation.js",
    "test:phase4-7": "tsx --test src/tests/phase4-phase7.test.ts",
    "test:wtr": "tsx --test src/tests/marketContinuity.test.ts src/tests/topazPoolCore.test.ts src/tests/graduationSearch.test.ts",
    "job:reconcile-graduations-once": "node --enable-source-maps dist/jobs/reconcileGraduationsOnce.js",
    "job:reconcile-graduations-once:dev": "tsx src/jobs/reconcileGraduationsOnce.ts",
    "job:cleanup-keep-factory:dry": "tsx scripts/cleanupKeepFactory.ts --dry-run",
    "job:cleanup-keep-factory": "tsx scripts/cleanupKeepFactory.ts --execute",
    "job:backfill-solana-trade-state": "node --enable-source-maps dist/jobs/backfillSolanaTradeCurveState.js",
    "job:backfill-solana-campaign": "node --enable-source-maps dist/jobs/backfillSolanaCampaign.js",
    "job:backfill-solana-campaign:dev": "tsx src/jobs/backfillSolanaCampaign.ts",
    "test:solana-history": "tsx --test src/tests/solanaCampaignHistory.test.ts src/tests/solanaCampaignLease.test.ts src/tests/solanaIndexerCheckpoint.test.ts",
    "cron:generate-launch-digest": "node --enable-source-maps dist/jobs/generateLaunchDigest.js",
    "cron:generate-trending-digest": "node --enable-source-maps dist/jobs/generateTrendingDigest.js",
    "cron:generate-league-standings": "node --enable-source-maps dist/jobs/generateLeagueStandings.js",
    "cron:generate-platform-briefs": "node --enable-source-maps dist/jobs/generatePlatformBriefs.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/cp-amm-sdk": "1.4.5",
    "@solana/web3.js": "1.95.4",
    "ably": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.19.2",
    "pg": "^8.13.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.16.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
