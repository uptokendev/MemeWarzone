# Coolify QA staging — product parity with production, Warzone ON, Robinhood testnet 46630.
# Production main stays Import-first / Arena-off / 4663 fail-closed. Do not copy these
# flags onto production.
#
# Shape vs production:
#   prod  = 56 + 101 + (4663 later)
#   QA    = 56 + 101 + 46630
#
# Apply in THREE Coolify services, then REBUILD the frontend (Vite bakes VITE_*).
# Phantom requires HTTPS (localhost excepted). After flipping Coolify to HTTPS,
# VITE_* API bases MUST be https:// or the browser blocks mixed content.
# Current Coolify hosts:
#   Frontend  https://4kdlgixhrtsorbqn6wi7kmr0.178.104.232.231.sslip.io
#   API       https://jkq5rjveklrueuuuputnpj6o.178.104.232.231.sslip.io
#   Indexer   https://s75mnp6dfpjtv8m8fcefxlay.178.104.232.231.sslip.io
# Staging DB  https://vrnsbguutnwgtekcexls.supabase.co
#
# LIVE VS EXAMPLE CHECK (2026-09-17, integration 60cf8cfa):
#   - HTTPS VITE bases are already correct in this example and were switched in Coolify.
#   - Frontend must be rebuilt from 60cf8cfa so the PublicNode fallback removal is baked.
#   - Last live indexer probe reported poolIndexerEnvEnabled=false even though the example
#     below is correct. Fix this in the INDEXER RUNTIME env, then restart only the indexer:
#       ENABLE_ROBINHOOD_V3_POOL_INDEXER=1
# One-shot post-graduation candle rebuild: comma-separated campaign addresses,
# or "all". Runs once per campaign and records that in indexer_state, so it is
# safe to leave set; it will not wipe and re-scan on every restart. To force
# another rebuild, delete the matching rh_v3_candle_rebuild row.
# ROBINHOOD_V3_CANDLE_REBUILD=
#       FACTORY_START_BLOCK_46630=120000000
#       EVM_INDEXER_CHAIN_IDS=56,46630
#       FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
#   - Do not rebuild the frontend for those four runtime-only indexer keys.
#
# FOUNDER FILL CHECKLIST — QA ONLY. Keep populated secrets in Coolify, not git.
#   FRONTEND: mainnet-beta RPC in VITE_SOLANA_RPC + VITE_SOLANA_MAINNET_RPC;
#             both must be the SAME paid Helius URL; devnet stays separate in
#             VITE_SOLANA_DEVNET_RPC.
#   API:      mainnet RPC in SOLANA_RPC_URL + SOLANA_RPC_HTTP; both must be the
#             SAME paid Helius URL, never PublicNode. Devnet uses
#             SOLANA_DEVNET_RPC_URL + SOLANA_DEVNET_RPC.
#   API:      SUPABASE_URL + SUPABASE_ANON_KEY + SUPABASE_SERVICE_ROLE_KEY must all
#             belong to vrnsbguutnwgtekcexls; use the project's Legacy API Key JWTs.
#   API:      ROBINHOOD_RPC_HTTP_46630 + ROBINHOOD_TESTNET_RPC_URL must be present.
#   INDEXER:  FACTORY_START_BLOCK_46630 + EVM_INDEXER_CHAIN_IDS +
#             ROBINHOOD_RPC_HTTP_46630 + ENABLE_ROBINHOOD_V3_POOL_INDEXER must be present.
#   INDEXER:  VOTE_TREASURY_ADDRESS_46630 must be present for 46630 vote indexing.
#   SAFETY:   REWARD_CLAIMS_ENABLED stays false. Do not add claim executor/funding flags.

# =============================================================================
# 1) FRONTEND — build-time only. Changing these without a rebuild does nothing.
# =============================================================================
VITE_RUNTIME_ENVIRONMENT=staging
VITE_ALLOWED_CHAIN_IDS=56,101,46630
VITE_DEFAULT_CHAIN_ID=46630
VITE_CAMPAIGN_FEED_CHAIN_ID=46630
VITE_FEATURED_FEED_CHAIN_ID=46630
VITE_TICKER_FEED_CHAIN_ID=46630
VITE_WAR_ROOM_CHAIN_ID=46630
VITE_DRAFT_FEED_CHAIN_ID=46630

VITE_ENABLE_WAR_ROOM=true
VITE_ENABLE_POSTGRAD=true
VITE_ENABLE_POSTGRAD_ARENA=true
VITE_ENABLE_DIRECT_ROBINHOOD_DEPLOY=true

VITE_FRONTEND_API_BASE=https://jkq5rjveklrueuuuputnpj6o.178.104.232.231.sslip.io
VITE_REALTIME_API_BASE=https://s75mnp6dfpjtv8m8fcefxlay.178.104.232.231.sslip.io
VITE_TOKEN_API_BASE=https://s75mnp6dfpjtv8m8fcefxlay.178.104.232.231.sslip.io

VITE_PUBLIC_RPC_56=https://bsc-dataseed.binance.org/
VITE_PUBLIC_RPC_46630=https://rpc.testnet.chain.robinhood.com
# Solana: keep these as TWO URLs. Do not point VITE_SOLANA_RPC at devnet.
# In live QA, VITE_SOLANA_RPC and VITE_SOLANA_MAINNET_RPC should be the same paid Helius URL.
VITE_SOLANA_CLUSTER=solana-mainnet-beta
VITE_SOLANA_RPC=<paid Solana MAINNET RPC>
VITE_SOLANA_MAINNET_RPC=<same paid Solana MAINNET RPC>
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

VITE_FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
VITE_CAMPAIGN_IMPLEMENTATION_ADDRESS_46630=0xf3EF4d2000B2eD2aBAC70a661F211f5eC1599E8f
VITE_TREASURY_ROUTER_ADDRESS_46630=0x144170c53ADBc5cF7Ec454612C948B931e231C9e
VITE_TREASURY_VAULT_ADDRESS_46630=0x290fD8eCA353637Be4a0cbC335095e5E6F5F16e2
VITE_PROTOCOL_REVENUE_VAULT_ADDRESS_46630=0xcDA6e2ca98c4BD6e831Ec04d4ED390535A6Da65C
VITE_PERMANENT_LP_LOCKER_ADDRESS_46630=0x1977178fDeAcE51318cA22B57dfdD246461b9f24
VITE_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
VITE_ARENA_WAR_POOL_TREASURY_V2_ADDRESS_46630=0x1eDd34933E5395c82F14CE2A220b81adF35C52B7
# Existing frontend value retained for compatibility. Do NOT add a server
# ARENA_VOTE_TREASURY_ADDRESS_46630 pointing at this same launchpad vote treasury:
# arenaVoteTreasury rejects launchpad/Arena treasury collisions. Leave server Arena
# paid-vote authority unset until a distinct attested 46630 Arena vote treasury exists.
VITE_ARENA_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
VITE_WRAPPED_NATIVE_ADDRESS_46630=0x52A47A33930B8a90a2000b1bA3CB96e879569670
VITE_ROBINHOOD_V3_FACTORY_ADDRESS_46630=0x948463E91d63a7A51cEeC0342735D1B738044aea
VITE_ROBINHOOD_V3_POSITION_MANAGER_ADDRESS_46630=0xfF64Bd6970966dB58F0dd65BA76669D3b8BE9eC4
VITE_ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_46630=0xDfd381ECfA6D4CcD4248e319C6fecD76A6bf3296
# Native ETH in/out on graduated Robinhood markets. Without this the Token
# Details buy panel fails with "Invalid Robinhood V3 native swap adapter."
# The adapter in deployments/robinhood/testnet.accepted.json belongs to the
# staged 0xF170 surface (its swapRouter/wrappedNative differ) and must NOT be
# used here. Deploy one bound to the live surface with the
# "RH46630 QA deploy native swap adapter" workflow, then paste it below.
VITE_ROBINHOOD_V3_NATIVE_SWAP_ADAPTER_ADDRESS_46630=<deploy-and-paste>
# Quoting. The live swap router is a real SwapRouter02 and exposes no quote
# function, so entering a buy amount reverts with no data. The staged mock
# router answered quoteExactInputSingle itself, which is why this was never
# needed before. Deployed by the same workflow as the adapter.
VITE_ROBINHOOD_V3_QUOTER_ADDRESS_46630=<deploy-and-paste>
ROBINHOOD_V3_QUOTER_ADDRESS_46630=<deploy-and-paste>
ROBINHOOD_V3_NATIVE_SWAP_ADAPTER_ADDRESS_46630=<deploy-and-paste>

# =============================================================================
# 2) BACKEND API — runtime. Same staging Supabase as the indexer.
# =============================================================================
VITE_RUNTIME_ENVIRONMENT=staging
POSTGRAD_API_ENABLED=true
POSTGRAD_ARENA_OPS_ENABLED=true
POSTGRAD_BATTLES_ENABLED=true
POSTGRAD_EVENTS_ENABLED=true
POSTGRAD_LEAGUE_ENABLED=true
POSTGRAD_WAR_POOLS_ENABLED=true
POSTGRAD_SPONSORSHIPS_ENABLED=true
POSTGRAD_ARENA_IMPORTS_ENABLED=true
STAGING_LEAGUE_ALLTIME_FALLBACK=true
ENABLE_UNIFIED_MARKET_API=1
ENABLE_UNIFIED_MARKET_CHART=1
WAR_ROOM_ENABLED=true

ENABLE_ROBINHOOD_CREATION=true
ROBINHOOD_ACCEPTANCE_ENABLE_LIVE=true
REWARD_CLAIMS_ENABLED=false

DATABASE_URL=postgresql://postgres.vrnsbguutnwgtekcexls:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# API ONLY. Use Project Settings -> API -> Legacy API Keys for this exact staging project.
# These code paths expect the legacy anon/service_role JWTs (normally eyJ...), not browser
# VITE_* copies and not the newer sb_publishable_/sb_secret_ replacements.
SUPABASE_URL=https://vrnsbguutnwgtekcexls.supabase.co
SUPABASE_ANON_KEY=<staging-anon-legacy-jwt>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-legacy-jwt>
SUPABASE_BUCKET=MEMEBATTLES

# Project Import. Both are OFF by default and the handler answers 404 when the
# first is unset, which reads as a missing route rather than a disabled feature.
# API only; the frontend just calls /api/project-imports.
ENABLE_PROJECT_IMPORTS=1
# Robinhood import is read-only project ownership on 4663. It activates no
# Robinhood creation, trading, claims or Arena. Without it the enabled chains
# are 56 and 101 only, and a 4663 import is rejected as an unsupported chain.
ENABLE_PROJECT_IMPORT_ROBINHOOD=1
# Read-only RPC used to resolve owner()/getOwner() for a 4663 import.
ROBINHOOD_MAINNET_RPC_URL=<robinhood-4663-rpc>
# Import resolves real tokens on production chains, read-only, so these are
# MAINNET RPCs. It reads its own variable names, NOT the indexer's: setting
# BSC_RPC_HTTP_56 alone leaves a BNB import answering 503, because the resolver
# never looks at that name.
#   56   BNB_RPC_URL | BSC_RPC_URL | BSC_MAINNET_RPC_URL
#   101  SOLANA_RPC_URL | SOLANA_MAINNET_RPC_URL
#   4663 ROBINHOOD_RPC_URL | ROBINHOOD_MAINNET_RPC_URL | RH_RPC_URL | RPC_URL_4663
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org/
PG_SSL_ALLOW_SELF_SIGNED=1
PG_SIMPLE_PROTOCOL=1

ABLY_API_KEY=<keyName:secret — same format as production, staging app>
# Mainnet 101 live coins (keep this as mainnet). Use the same paid Helius URL for
# SOLANA_RPC_URL and SOLANA_RPC_HTTP; never PublicNode here.
SOLANA_RPC_URL=<paid-or-dedicated Solana MAINNET RPC>
SOLANA_RPC_HTTP=<same MAINNET RPC>
SOLANA_CLUSTER=solana-mainnet-beta
# Devnet only. Never copy this into SOLANA_RPC_URL.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# 46630 API reads use these names. There is no generic ROBINHOOD_RPC consumer here.
ROBINHOOD_RPC_HTTP_46630=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Runtime CORS. Code reads CORS_ALLOWED_ORIGINS (sslip.io hosts are also allowed
# by hostname). Keep both schemes during the HTTP→HTTPS cutover.
CORS_ALLOWED_ORIGINS=https://4kdlgixhrtsorbqn6wi7kmr0.178.104.232.231.sslip.io,http://4kdlgixhrtsorbqn6wi7kmr0.178.104.232.231.sslip.io,https://staging.memewar.zone
ALLOWED_ORIGINS=https://4kdlgixhrtsorbqn6wi7kmr0.178.104.232.231.sslip.io,http://4kdlgixhrtsorbqn6wi7kmr0.178.104.232.231.sslip.io,https://staging.memewar.zone

FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
ARENA_WAR_POOL_TREASURY_V2_ADDRESS_46630=0x1eDd34933E5395c82F14CE2A220b81adF35C52B7
ARENA_POSTGRAD_LEAGUE_TREASURY_V2_ADDRESS_46630=0x794Cbd0912A71394f25B81C32f3994cC737A4B13
# Frontend-only compatibility value. Server Arena vote authority intentionally stays unset
# until a distinct, attested treasury is available; do not alias the launchpad vote treasury.
VITE_ARENA_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789

# =============================================================================
# 3) INDEXER — runtime. MUST use the staging DATABASE_URL, never production.
# =============================================================================
DATABASE_URL=postgresql://postgres.vrnsbguutnwgtekcexls:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
PG_SSL_ALLOW_SELF_SIGNED=1
PG_SIMPLE_PROTOCOL=1
ABLY_API_KEY=<same staging key as API>
# Use the same paid Helius MAINNET RPC as the API; never PublicNode.
SOLANA_RPC_URL=<same MAINNET RPC as API>
SOLANA_RPC_HTTP=<same MAINNET RPC as API>
SOLANA_CLUSTER=solana-mainnet-beta
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Must serve eth_getLogs. Claim recovery reconstructs evidence from
# RewardClaimed logs, and an endpoint that refuses log queries reports a valid,
# already-paid entitlement as unrecoverable rather than erroring usefully.
# bsc-dataseed.binance.org answers getBlockNumber but refuses getLogs at every
# range, so it cannot be used here. A paid endpoint or publicnode works.
# Range limits differ per provider; the scan narrows itself, but a provider that
# refuses logs outright cannot be narrowed into working.
BSC_RPC_HTTP_56=<log-capable BSC mainnet RPC>
# Indexer consumes ROBINHOOD_RPC_HTTP_46630 (or ROBINHOOD_TESTNET_RPC_URL alias).
# Do not invent a plain ROBINHOOD_RPC variable; the runtime does not read it.
ROBINHOOD_RPC_HTTP_46630=https://rpc.testnet.chain.robinhood.com
FACTORY_ADDRESS_56=0xc378221E57898106079aE4B818a92978e4cd9559
# Live QA factory. Never substitute the historical staged/accepted 0xF170... factory.
FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
# Current QA scan start for the live 0xd03D... generation. Do not use the old 0xF170... start block.
FACTORY_START_BLOCK_46630=120000000
SUPPORTED_FACTORY_ADDRESSES_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
SUPPORTED_FACTORY_START_BLOCKS_46630=120000000
EVM_INDEXER_CHAIN_IDS=56,46630
VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
ENABLE_ROBINHOOD_V3_POOL_INDEXER=1
ENABLE_UNIFIED_MARKET_API=1
ENABLE_UNIFIED_MARKET_CHART=1
ENABLE_TOPAZ_POOL_INDEXER=0
# Chains stay 56 + 46630 + Solana 101. Do not point this indexer at production Supabase.
