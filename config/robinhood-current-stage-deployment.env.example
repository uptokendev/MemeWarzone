# Robinhood Chain Testnet (46630) current-generation deployment operator template.
# This file contains no usable secrets or deployment addresses.
# Populate only in the secure operator environment; never commit the populated copy.

ROBINHOOD_TESTNET_RPC_URL=https://<dedicated-robinhood-testnet-rpc>
ROBINHOOD_TESTNET_DEPLOYER_PRIVATE_KEY=<secure-operator-only>
ROBINHOOD_TESTNET_ADMIN=0x<staging-admin-controlled-by-deployer>
ROBINHOOD_ROUTE_AUTHORITY_ADDRESS=0x<separate-route-config-authority>

# Existing chain-46630 external infrastructure must be independently attested.
# Historical 5B/5C addresses are rejected and must not be copied here.
ROBINHOOD_WETH_ADDRESS_46630=0x<current-weth>
ROBINHOOD_V3_FACTORY_ADDRESS_46630=0x<current-v3-factory>
ROBINHOOD_V3_POSITION_MANAGER_ADDRESS_46630=0x<current-v3-position-manager>
ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_46630=0x<current-v3-swap-router>
ROBINHOOD_NATIVE_USD_ORACLE_ADDRESS_46630=0x<current-native-usd-feed>

# TreasuryRouterV3 and the strictly required MemeWarzone vault dependencies are
# deployed fresh by this executor. No pre-existing treasury address is accepted.
ROBINHOOD_NATIVE_USD_MAX_ORACLE_AGE_SECONDS=900
ROBINHOOD_TESTNET_MIN_DEPLOYER_BALANCE_WEI=50000000000000000

# Intentionally empty by default. Dry-run/preflight sends no transactions.
# Set ONLY for the approved funded staging deployment:
# ROBINHOOD_TESTNET_BROADCAST=DEPLOY_CHAIN_46630_CURRENT_STAGE

# Dry-run / preflight:
# npx hardhat run scripts/deploy-robinhood-current-stage.ts --network robinhoodTestnet
#
# A successful funded broadcast writes deployments/robinhood/testnet.staged.json
# exclusively from actual deployment/wiring receipts and refuses to overwrite an
# existing manifest.
