# Robinhood Chain Testnet (46630) infrastructure bootstrap operator template.
# Never commit a populated copy or any private key/RPC credential.

ROBINHOOD_TESTNET_RPC_URL=https://<dedicated-robinhood-testnet-rpc>
ROBINHOOD_TESTNET_DEPLOYER_PRIVATE_KEY=<secure-operator-only>

# Public updater address for the testnet-only ETH/USD AggregatorV3-compatible feed.
# It may be distinct from the infrastructure deployer.
ROBINHOOD_TESTNET_ORACLE_UPDATER=0x<testnet-oracle-updater>

# Initial ETH/USD answer in 8 decimals. Example syntax only; operator must provide
# a current honest testnet reference immediately before broadcast.
ROBINHOOD_TESTNET_ORACLE_INITIAL_ETH_USD_8=<positive-8-decimal-integer>
ROBINHOOD_NATIVE_USD_MAX_ORACLE_AGE_SECONDS=900

# Dry-run / preflight sends no transactions:
# npx hardhat run scripts/deploy-robinhood-testnet-infrastructure.ts --network robinhoodTestnet

# Broadcast requires this exact opt-in token:
# ROBINHOOD_TESTNET_INFRA_BROADCAST=DEPLOY_CHAIN_46630_TESTNET_INFRA

# Successful broadcast writes only receipt-derived public infrastructure to:
# deployments/robinhood/testnet.infrastructure.json
# It never writes the private key or RPC credential.
