# MemeWarzone Arena auxiliary deployment bundle.
# EventPrizeVaultV1 + WarzoneSponsorshipRouterV1 + a distinct Arena UPVoteTreasury.
# No usable secrets or production addresses belong in this file.
#
# The deploy runner supports:
#   BNB mainnet 56 / BSC testnet 97 / Robinhood mainnet 4663 / Robinhood testnet 46630.
# Every non-local authority/receiver input is chain-suffixed and fail-closed.
#
# Broadcast confirmation is exact-chain:
#   ARENA_AUX_DEPLOY_CONFIRM=DEPLOY_ARENA_AUX_56
#   ARENA_AUX_DEPLOY_CONFIRM=DEPLOY_ARENA_AUX_97
#   ARENA_AUX_DEPLOY_CONFIRM=DEPLOY_ARENA_AUX_4663
#   ARENA_AUX_DEPLOY_CONFIRM=DEPLOY_ARENA_AUX_46630
ARENA_AUX_DEPLOY_CONFIRM=

# BNB mainnet 56
ARENA_AUX_EXPECTED_DEPLOYER_56=
ARENA_AUX_OWNER_56=
ARENA_AUX_VOTE_OWNER_56=
ARENA_SPONSORSHIP_QUOTE_SIGNER_56=
ARENA_MARKETING_RECEIVER_56=
ARENA_PROTOCOL_RECEIVER_56=
# Optional collision guard. If populated, the new Arena vote treasury must differ.
VOTE_TREASURY_ADDRESS_56=

# BSC testnet 97
ARENA_AUX_EXPECTED_DEPLOYER_97=
ARENA_AUX_OWNER_97=
ARENA_AUX_VOTE_OWNER_97=
ARENA_SPONSORSHIP_QUOTE_SIGNER_97=
ARENA_MARKETING_RECEIVER_97=
ARENA_PROTOCOL_RECEIVER_97=
VOTE_TREASURY_ADDRESS_97=

# Robinhood mainnet 4663
ARENA_AUX_EXPECTED_DEPLOYER_4663=
ARENA_AUX_OWNER_4663=
ARENA_AUX_VOTE_OWNER_4663=
ARENA_SPONSORSHIP_QUOTE_SIGNER_4663=
ARENA_MARKETING_RECEIVER_4663=
ARENA_PROTOCOL_RECEIVER_4663=
VOTE_TREASURY_ADDRESS_4663=
# Secret stays in the operator environment, never here:
ROBINHOOD_MAINNET_DEPLOYER_PRIVATE_KEY=<production-operator-only>

# Robinhood testnet 46630
ARENA_AUX_EXPECTED_DEPLOYER_46630=
ARENA_AUX_OWNER_46630=
ARENA_AUX_VOTE_OWNER_46630=
ARENA_SPONSORSHIP_QUOTE_SIGNER_46630=
ARENA_MARKETING_RECEIVER_46630=
ARENA_PROTOCOL_RECEIVER_46630=
VOTE_TREASURY_ADDRESS_46630=
ROBINHOOD_TESTNET_DEPLOYER_PRIVATE_KEY=<staging-operator-only>

# Outputs are written only after successful deployment/wiring and are non-overwriting:
# deployments/arena/auxiliary-bundle.bsc56.json
# deployments/arena/auxiliary-bundle.bsc97.json
# deployments/arena/auxiliary-bundle.robinhood4663.json
# deployments/arena/auxiliary-bundle.robinhood46630.json
#
# The bundle is dark by construction:
# - EventPrizeVaultV1 depositsPaused = true
# - WarzoneSponsorshipRouterV1 paymentsPaused = true
# - no event receivers configured
# - no sponsorship event enabled
# - no public feature flag changed
