# Solana rewards treasury mainnet upgrade operator template.
# This file contains no usable RPC credential, keypair, or candidate hash.
# The guarded executor is dry-run by default and upgrades the existing same program ID.
SOLANA_RPC=https://<mainnet-beta-rpc>
SOLANA_REWARDS_TREASURY_PROGRAM_ID=2NzthKEZHtbnqXxT4eeEnEQRHkQsdqgqVsfzcCCoZBKX
SOLANA_REWARDS_RELEASE_CANDIDATE_SHA256=<sha256-from-exact-passing-rewards-build>
SOLANA_REWARDS_UPGRADE_AUTHORITY_KEYPAIR=/secure/path/rewards-upgrade-authority.json

# Optional explicit output. If omitted:
# reports/solana/rewards-upgrade-<candidate-sha256>.json
# The executor uses exclusive creation and refuses an existing evidence file.
SOLANA_REWARDS_UPGRADE_EVIDENCE_FILE=

# Leave blank for dry-run. Set only for an approved same-ID mainnet upgrade:
# SOLANA_REWARDS_UPGRADE_CONFIRM=UPGRADE_MWZ_REWARDS_MAINNET
SOLANA_REWARDS_UPGRADE_CONFIRM=

# Claims/funding activation is separate and remains dark through the upgrade.
REWARD_CLAIMS_ENABLED=false
REWARD_CLAIM_VERIFY_ENABLED=false
REWARD_FUNDING_EXECUTOR_ENABLED=false
