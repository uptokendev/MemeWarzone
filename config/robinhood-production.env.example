# MemeWarzone Robinhood Chain production environment
# Chain: Robinhood Mainnet (4663)
# Production activation must use the same accepted source commit as staging.
# TESTNET MOCK V3 / MOCK ORACLE ADDRESSES ARE FORBIDDEN IN THIS FILE.

VITE_RUNTIME_ENVIRONMENT=production
VITE_PUBLIC_RPC_4663=https://<robinhood-mainnet-rpc>
VITE_ALLOWED_CHAIN_IDS=56,101,4663
VITE_DEFAULT_CHAIN_ID=56

# Robinhood is a separate selectable product chain; these values are only used
# when the selected feed is Robinhood. BNB and Solana keep independent state.
VITE_CAMPAIGN_FEED_CHAIN_ID=56
VITE_FEATURED_FEED_CHAIN_ID=56
VITE_TICKER_FEED_CHAIN_ID=56
VITE_WAR_ROOM_CHAIN_ID=56
VITE_DRAFT_FEED_CHAIN_ID=56

# Server/indexer RPC. Use dedicated provider credentials with independent failover.
ROBINHOOD_MAINNET_CHAIN_ID=4663
ROBINHOOD_MAINNET_RPC_URL=https://<dedicated-robinhood-mainnet-rpc>
ROBINHOOD_RPC_HTTP_4663=https://<dedicated-robinhood-mainnet-rpc>
ROBINHOOD_DEPLOYMENT_MANIFEST=deployments/robinhood/mainnet.json
DEFAULT_EVM_CHAIN_ID=56
EVM_INDEXER_CHAIN_IDS=56

# Populate only after separate Robinhood mainnet deployment + canary acceptance.
# Never use 46630 addresses or the controlled mock V3 stack here.
VITE_FACTORY_ADDRESS_4663=
VITE_CAMPAIGN_IMPLEMENTATION_ADDRESS_4663=
VITE_TREASURY_ROUTER_ADDRESS_4663=
VITE_TREASURY_VAULT_ADDRESS_4663=
VITE_RECRUITER_REWARDS_VAULT_ADDRESS_4663=
VITE_COMMUNITY_REWARDS_VAULT_ADDRESS_4663=
VITE_PROTOCOL_REVENUE_VAULT_ADDRESS_4663=
VITE_CREATOR_REGISTRY_ADDRESS_4663=
VITE_RISK_REGISTRY_ADDRESS_4663=
VITE_GRADUATION_ORACLE_ADDRESS_4663=
VITE_PERMANENT_LP_LOCKER_ADDRESS_4663=
VITE_VOTE_TREASURY_ADDRESS_4663=
VITE_LAUNCH_ROUTER_ADDRESS_4663=
VITE_ROBINHOOD_V3_FACTORY_ADDRESS_4663=
VITE_ROBINHOOD_V3_POSITION_MANAGER_ADDRESS_4663=
VITE_ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_4663=
VITE_WRAPPED_NATIVE_ADDRESS_4663=

FACTORY_ADDRESS_4663=
FACTORY_START_BLOCK_4663=
SUPPORTED_FACTORY_ADDRESSES_4663=
SUPPORTED_FACTORY_START_BLOCKS_4663=
VOTE_TREASURY_ADDRESS_4663=
VOTE_TREASURY_START_BLOCK_4663=
TREASURY_ROUTER_ADDRESS_4663=
TREASURY_VAULT_ADDRESS_4663=
RECRUITER_REWARDS_VAULT_ADDRESS_4663=
COMMUNITY_REWARDS_VAULT_ADDRESS_4663=
PROTOCOL_REVENUE_VAULT_ADDRESS_4663=
CHARITY_TREASURY_ADDRESS_4663=
ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_4663=

# Market continuity remains dark until the real 4663 pool route is independently
# verified. BNB Topaz continues to use its own indexer and must not be disabled.
ENABLE_UNIFIED_MARKET_API=1
ENABLE_UNIFIED_MARKET_CHART=1
ENABLE_ROBINHOOD_V3_POOL_INDEXER=0
ROBINHOOD_V3_POOL_INDEXER_INTERVAL_MS=5000
ROBINHOOD_V3_POOL_INDEXER_MAX_POOLS=100

# Completely separate production secrets.
DATABASE_URL=postgresql://<production-only>
SUPABASE_URL=https://<production-only>
SUPABASE_SERVICE_ROLE_KEY=<production-only>
ABLY_API_KEY=<production-only>
ROUTE_AUTHORITY_PRIVATE_KEY=<production-only>
ROBINHOOD_ROUTE_AUTHORITY_PRIVATE_KEY=<production-only>
PRIVATE_KEY_DEPLOY=<production-only>

ALLOWED_ORIGINS=https://app.memewar.zone

# Must remain false until mainnet canary acceptance is complete.
ENABLE_ROBINHOOD_CREATION=false
VITE_ENABLE_DIRECT_ROBINHOOD_DEPLOY=false
