# Robinhood Mainnet (chain 4663) production deployment executor inputs.
# Never commit real private keys or secret-bearing RPC URLs.
# Populate these in the secure operator environment / secret manager only.

ROBINHOOD_MAINNET_RPC_URL=https://<dedicated-robinhood-mainnet-rpc>
ROBINHOOD_MAINNET_DEPLOYER_PRIVATE_KEY=<secure-production-admin-key-only>

# The accepted Stock graduation adapter has immutable admin=msg.sender.
# Therefore the connected deployer MUST equal this production admin address.
ROBINHOOD_MAINNET_ADMIN_ADDRESS=0x<production-admin>

# Must be a separate production authority from the deployer/admin.
ROBINHOOD_MAINNET_ROUTE_AUTHORITY_ADDRESS=0x<production-route-authority>

# Real chain-4663 production dependencies. No testnet mocks.
ROBINHOOD_MAINNET_WETH_ADDRESS=0x<canonical-production-weth>
ROBINHOOD_MAINNET_V3_FACTORY_ADDRESS=0x<approved-production-v3-factory>
ROBINHOOD_MAINNET_V3_POSITION_MANAGER_ADDRESS=0x<approved-production-position-manager>
ROBINHOOD_MAINNET_V3_SWAP_ROUTER_ADDRESS=0x<approved-production-swap-router>
ROBINHOOD_MAINNET_NATIVE_USD_ORACLE_ADDRESS=0x<approved-production-eth-usd-feed>

ROBINHOOD_STOCK_GRADUATION_MAX_ORACLE_AGE_SECONDS=900
# Optional minimum deployer funding floor in wei; executor defaults to 0.02 ETH.
# ROBINHOOD_MAINNET_MIN_DEPLOYER_BALANCE_WEI=

# Phase 1: omit this value for read-only dependency preflight.
# Phase 2: set exactly this acknowledgement only after the preflight table is reviewed.
# ROBINHOOD_MAINNET_BROADCAST=DEPLOY_CHAIN_4663_DARK

# Generated evidence. These files contain addresses/transactions, NEVER keys.
ROBINHOOD_MAINNET_INVENTORY_OUT=deployments/robinhood/mainnet.inventory.generated.json
ROBINHOOD_MAINNET_RECEIPT_OUT=deployments/robinhood/mainnet.deployment-receipt.json

# Candidate manifest is deliberately deferred until one real canary Stock route has
# exact provider identity, Stock/USD feed, WETH/QUOTE pool, quoter/router and policy.
# ROBINHOOD_MAINNET_CANARY_INVENTORY=/secure/path/to/robinhood-mainnet-canary.inventory.json
# ROBINHOOD_MAINNET_CANDIDATE_OUT=deployments/robinhood/mainnet.candidate.json
