# MemeWarzone Robinhood Chain permanent staging environment
# Chain: Robinhood Testnet (46630)
# Never copy production secrets into this environment.

VITE_RUNTIME_ENVIRONMENT=staging
VITE_PUBLIC_RPC_46630=https://<robinhood-testnet-rpc>
VITE_ALLOWED_CHAIN_IDS=97,101,46630
VITE_DEFAULT_CHAIN_ID=46630

# Keep Robinhood as its own product feed. BNB/Solana remain independently selectable.
VITE_CAMPAIGN_FEED_CHAIN_ID=46630
VITE_FEATURED_FEED_CHAIN_ID=46630
VITE_TICKER_FEED_CHAIN_ID=46630
VITE_WAR_ROOM_CHAIN_ID=46630
VITE_DRAFT_FEED_CHAIN_ID=46630

# Server/indexer RPC. Use dedicated provider credentials in deployed staging.
ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_RPC_URL=https://<dedicated-robinhood-testnet-rpc>
ROBINHOOD_RPC_HTTP_46630=https://<dedicated-robinhood-testnet-rpc>
ROBINHOOD_DEPLOYMENT_MANIFEST=deployments/robinhood/testnet.staged.json
DEFAULT_EVM_CHAIN_ID=46630
EVM_INDEXER_CHAIN_IDS=46630

# Contract addresses are generated from the staged deployment manifest after deploy.
# Never reuse unsuffixed BNB variables for Robinhood.
VITE_FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
VITE_CAMPAIGN_IMPLEMENTATION_ADDRESS_46630=0xf3EF4d2000B2eD2aBAC70a661F211f5eC1599E8f
VITE_TREASURY_ROUTER_ADDRESS_46630=0x144170c53ADBc5cF7Ec454612C948B931e231C9e
VITE_TREASURY_VAULT_ADDRESS_46630=0x290fD8eCA353637Be4a0cbC335095e5E6F5F16e2
VITE_RECRUITER_REWARDS_VAULT_ADDRESS_46630=0x95c3E9785DE410927307953fa5cf943399397A28
VITE_COMMUNITY_REWARDS_VAULT_ADDRESS_46630=0x14DF8952474dC16648815727683feB089dB9026D
VITE_CREATOR_REWARDS_VAULT_ADDRESS_46630=0x57C2e716F1898D4818FEc3990e03E9997cE9052C
VITE_PROTOCOL_REVENUE_VAULT_ADDRESS_46630=0xcDA6e2ca98c4BD6e831Ec04d4ED390535A6Da65C
VITE_CREATOR_REGISTRY_ADDRESS_46630=0x75220e9C40782083Bc5cfd4709E3525e5AD603E6
VITE_RISK_REGISTRY_ADDRESS_46630=0x05E7cc591ed411ba49386Ad31FDC0715609D0325
VITE_GRADUATION_ORACLE_ADDRESS_46630=0x399E529c0C6888543E6501FD137ac49CA3E1Df58
VITE_PERMANENT_LP_LOCKER_ADDRESS_46630=0x1977178fDeAcE51318cA22B57dfdD246461b9f24
VITE_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
VITE_LAUNCH_ROUTER_ADDRESS_46630=0x3A2f190Dc17BA64E241f223D34dFf25984476Cbe

# The API/indexer consumes the same staged generation through server-only names.
FACTORY_ADDRESS_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
FACTORY_START_BLOCK_46630=<deployment-block>
SUPPORTED_FACTORY_ADDRESSES_46630=0xd03D1CC03d108B7F9b2195489DC6CFda1FB1a943
SUPPORTED_FACTORY_START_BLOCKS_46630=<deployment-block>
VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
VOTE_TREASURY_START_BLOCK_46630=<upvote-deployment-block>
TREASURY_ROUTER_ADDRESS_46630=0x144170c53ADBc5cF7Ec454612C948B931e231C9e
TREASURY_VAULT_ADDRESS_46630=0x290fD8eCA353637Be4a0cbC335095e5E6F5F16e2
RECRUITER_REWARDS_VAULT_ADDRESS_46630=0x95c3E9785DE410927307953fa5cf943399397A28
COMMUNITY_REWARDS_VAULT_ADDRESS_46630=0x14DF8952474dC16648815727683feB089dB9026D
CREATOR_REWARDS_VAULT_ADDRESS_46630=0x57C2e716F1898D4818FEc3990e03E9997cE9052C
PROTOCOL_REVENUE_VAULT_ADDRESS_46630=0xcDA6e2ca98c4BD6e831Ec04d4ED390535A6Da65C
CHARITY_TREASURY_ADDRESS_46630=0x<charity-treasury>

# Attested Arena V2 staging contracts. Chain 46630 only; no production 4663 values belong here.
ARENA_WAR_POOL_TREASURY_V2_ADDRESS_46630=0x1eDd34933E5395c82F14CE2A220b81adF35C52B7
ARENA_WAR_POOL_TREASURY_V2_RUNTIME_HASH_46630=0x79979c3684c328e866c2b5b03d276cda7072a4c39d7f5b55c42672f9cb82958d
VITE_ARENA_WAR_POOL_TREASURY_V2_ADDRESS_46630=0x1eDd34933E5395c82F14CE2A220b81adF35C52B7
ARENA_POSTGRAD_LEAGUE_TREASURY_V2_ADDRESS_46630=0x794Cbd0912A71394f25B81C32f3994cC737A4B13
ARENA_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789
VITE_ARENA_VOTE_TREASURY_ADDRESS_46630=0x670256a51020477e4E96d7D7a94ac1783F1B1789

# The live RH staging host must also set POSTGRAD_WAR_POOLS_ENABLED=true and
# POSTGRAD_BATTLES_ENABLED=true when Launch Control authorizes staging acceptance.
# Set those flags on RH staging only; do not enable them on production main.

# Weekly vault = GREEN weeklyLeagueVault; UPVoteTreasury forwards native ETH to ProtocolRevenueVault.

# Merkle reward custody. Deploy a distinct RewardDistributor on 46630; claims stay
# disabled until the distributor is funded, root publication is verified, and the
# claim API's Robinhood chain gate has passed acceptance.
REWARD_DISTRIBUTOR_ADDRESS_46630=0x<reward-distributor>
REWARD_DISTRIBUTOR_OWNER_46630=0x<staging-reward-owner>
REWARD_CLAIMS_ENABLED=false
REWARD_CLAIM_VERIFY_ENABLED=false
REWARD_FUNDING_EXECUTOR_ENABLED=false

# Controlled Uniswap V3-compatible staging DEX. TESTNET ONLY.
VITE_ROBINHOOD_V3_FACTORY_ADDRESS_46630=0x948463E91d63a7A51cEeC0342735D1B738044aea
VITE_ROBINHOOD_V3_POSITION_MANAGER_ADDRESS_46630=0xfF64Bd6970966dB58F0dd65BA76669D3b8BE9eC4
VITE_ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_46630=0xDfd381ECfA6D4CcD4248e319C6fecD76A6bf3296
VITE_ROBINHOOD_V3_NATIVE_SWAP_ADAPTER_ADDRESS_46630=0x<native-v3-swap-adapter>
VITE_ROBINHOOD_V3_MULTI_HOP_SWAP_ADAPTER_ADDRESS_46630=0x<stock-multihop-v3-swap-adapter>
VITE_WRAPPED_NATIVE_ADDRESS_46630=0x52A47A33930B8a90a2000b1bA3CB96e879569670
ROBINHOOD_V3_SWAP_ROUTER_ADDRESS_46630=0xDfd381ECfA6D4CcD4248e319C6fecD76A6bf3296
ROBINHOOD_V3_NATIVE_SWAP_ADAPTER_ADDRESS_46630=0x<native-v3-swap-adapter>
ROBINHOOD_V3_MULTI_HOP_SWAP_ADAPTER_ADDRESS_46630=0x<stock-multihop-v3-swap-adapter>
WRAPPED_NATIVE_ADDRESS_46630=0x52A47A33930B8a90a2000b1bA3CB96e879569670

# Dedicated onchain ETH/USD reference for irreversible Stock graduation decisions.
# This must be a fresh, positive Chainlink-style feed; do not use Binance/display pricing here.
ROBINHOOD_NATIVE_USD_ORACLE_ADDRESS_46630=0x<native-usd-oracle-feed>
ROBINHOOD_NATIVE_USD_MAX_ORACLE_AGE_SECONDS=900

# Read-only Stock Battlefield registry. Keep graduation/trading dark until the
# stock-route contracts and acceptance passes are explicitly enabled later.
# For staging, acquisitionQuoterAddress may point at the controlled mock V3 router
# because it exposes the SIMPLE_EXACT_INPUT_SINGLE read surface used by RH-S5.
ROBINHOOD_STOCK_MAX_ORACLE_AGE_SECONDS=900
ROBINHOOD_STOCK_TOKEN_REGISTRY_46630=[{"contractAddress":"0x<canonical-stock-token>","symbol":"NVDA","displayName":"NVIDIA Stock Token","underlyingSymbol":"NVDA","decimals":18,"oracleFeedAddress":"0x<stock-oracle-feed>","oracleType":"chainlink","canonical":true,"enabledForDiscovery":true,"enabledForGraduation":false,"enabledForTrading":false,"minimumQuoteLiquidityUsd":25000,"maximumGraduationSwapImpactBps":500,"acquisitionPoolAddress":"0x<approved-weth-stock-v3-pool>","acquisitionQuoterAddress":"0x<mock-v3-swap-router>","acquisitionRouterAddress":"0x<mock-v3-swap-router>","acquisitionFeeTier":3000,"acquisitionQuoteKind":"SIMPLE_EXACT_INPUT_SINGLE"}]

# Versioned RH-S5 graduation quote safety policy. Read/simulation only at this phase.
ROBINHOOD_STOCK_GRADUATION_POLICY_VERSION=robinhood_stock_graduation_v1
ROBINHOOD_STOCK_GRADUATION_MAX_ORACLE_AGE_SECONDS=900
ROBINHOOD_STOCK_GRADUATION_MAX_SWAP_SLIPPAGE_BPS=300
ROBINHOOD_STOCK_GRADUATION_MAX_ORACLE_DEVIATION_BPS=300
ROBINHOOD_STOCK_GRADUATION_MAX_PRICE_IMPACT_BPS=500
ROBINHOOD_STOCK_GRADUATION_MIN_ROUTE_LIQUIDITY_USD=25000
ROBINHOOD_STOCK_GRADUATION_QUOTE_DEADLINE_SECONDS=60

# Rollout flags. Keep all execution/product surfaces dark until their specific phase passes.
# Server flags are authoritative for signing/execution. VITE flags only expose accepted browser surfaces.
ROBINHOOD_STOCK_MARKETS=false
ROBINHOOD_STOCK_GRADUATION=false
ROBINHOOD_STOCK_ETH_ROUTING=false
ROBINHOOD_STOCK_MARKET_UI=false
ROBINHOOD_BEAT_THE_MARKET=false
VITE_ROBINHOOD_STOCK_ETH_ROUTING=false
VITE_ROBINHOOD_STOCK_MARKET_UI=false

# Market-continuity runtime. Keep the V3 scanner disabled until the migration,
# staged manifest, and isolated DB are all applied; enable it during acceptance.
ENABLE_UNIFIED_MARKET_API=1
ENABLE_UNIFIED_MARKET_CHART=1
ENABLE_TOPAZ_POOL_INDEXER=0
ENABLE_ROBINHOOD_V3_POOL_INDEXER=0
ROBINHOOD_V3_POOL_INDEXER_INTERVAL_MS=5000
ROBINHOOD_V3_POOL_INDEXER_MAX_POOLS=100

# Completely separate staging secrets.
DATABASE_URL=postgresql://<staging-only>
SUPABASE_URL=https://<staging-only>
SUPABASE_SERVICE_ROLE_KEY=<staging-only>
ABLY_API_KEY=<staging-only>
ROUTE_AUTHORITY_PRIVATE_KEY=<staging-only>
ROBINHOOD_ROUTE_AUTHORITY_PRIVATE_KEY=<staging-only>
PRIVATE_KEY_DEPLOY=<staging-only>

# Acceptance wallets. Fund with Robinhood testnet ETH only.
ROBINHOOD_TEST_CREATOR_PRIVATE_KEY=<staging-test-wallet-only>
ROBINHOOD_TEST_SCHEDULED_CREATOR_PRIVATE_KEY=<staging-test-wallet-only>
ROBINHOOD_TEST_BUYER_PRIVATE_KEY=<staging-test-wallet-only>
ROBINHOOD_TEST_TRADER_PRIVATE_KEY=<staging-test-wallet-only>

# Staging origins only.
ALLOWED_ORIGINS=https://staging.memewar.zone

# Robinhood creation remains disabled in deployed services until acceptance passes.
ENABLE_ROBINHOOD_CREATION=false
VITE_ENABLE_DIRECT_ROBINHOOD_DEPLOY=false
ROBINHOOD_ACCEPTANCE_ENABLE_LIVE=false
