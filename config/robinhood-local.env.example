# MemeWarzone Robinhood local acceptance environment
# Copy this file to config/robinhood.local (ignored by git) and fill only local/test values.
# The local runner rejects non-loopback API/indexer/database targets.

RUNTIME_ENVIRONMENT=local
VITE_RUNTIME_ENVIRONMENT=local

# Dedicated LOCAL PostgreSQL database. Never point this at Supabase/Coolify/prod.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/memewarzone_robinhood_local
PG_DISABLE_SSL=1
PG_SIMPLE_PROTOCOL=0

# Robinhood Testnet is the only external network dependency in this profile.
ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_HTTP_46630=https://rpc.testnet.chain.robinhood.com
DEFAULT_EVM_CHAIN_ID=46630
EVM_INDEXER_CHAIN_IDS=46630

# Filled after the Robinhood test factory is deployed.
FACTORY_ADDRESS_46630=
FACTORY_START_BLOCK_46630=0
SUPPORTED_FACTORY_ADDRESSES_46630=
SUPPORTED_FACTORY_START_BLOCKS_46630=
VOTE_TREASURY_ADDRESS_46630=
VOTE_TREASURY_START_BLOCK_46630=0

# Local service topology. The runner force-overrides these values as an extra guard.
VITE_DEFAULT_CHAIN_ID=46630
VITE_ALLOWED_CHAIN_IDS=46630
VITE_PUBLIC_RPC_46630=https://rpc.testnet.chain.robinhood.com
VITE_FRONTEND_API_BASE=http://127.0.0.1:3001
VITE_TOKEN_API_BASE=http://127.0.0.1:3002
VITE_REALTIME_API_BASE=http://127.0.0.1:3002
VITE_API_BASE=http://127.0.0.1:3002
LOCAL_INDEXER_API_BASE_URL=http://127.0.0.1:3002
RAILWAY_API_BASE_URL=http://127.0.0.1:3002
RAILWAY_INDEXER_URL=http://127.0.0.1:3002
API_RAILWAY_PROXY=1
API_RAILWAY_PROXY_STRICT=1

# Local isolation. No production Ably, Supabase storage or telemetry.
LOCAL_DISABLE_ABLY=1
LOCAL_DISABLE_REMOTE_SUPABASE=1
ENABLE_DATA_URL_UPLOADS=1
TELEMETRY_INGEST_URL=
TELEMETRY_TOKEN=

# Disable unrelated chain workers in this Robinhood-only local profile.
BSC_RPC_HTTP_56=
BSC_RPC_HTTP_97=
SOLANA_RPC_HTTP=
SOLANA_LAUNCHPAD_PROGRAM_ID=
ENABLE_TOPAZ_POOL_INDEXER=0
ENABLE_GRADUATION_HANDOFF_RECONCILER=0

# Keep market REST APIs available against the local database.
ENABLE_UNIFIED_MARKET_API=1
ENABLE_UNIFIED_MARKET_CHART=1

# Local ports.
FRONTEND_PORT=5173
FRONTEND_API_PORT=3001
INDEXER_PORT=3002
